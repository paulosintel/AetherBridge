# ==============================================================================
# AetherBridge .gitignore
# ==============================================================================

# Credenciales y variables sensibles (CRÍTICO)
api_keys.env
*.env
*.env.local
!api_keys.env.example

# Logs y bases de datos locales
logs/
*.log
.omniroute/
*.sqlite
*.sqlite3

# Python cache y entornos virtuales
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Dependencias temporales y archivos empaquetados
node_modules/
*.zip
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operativo y editores
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
